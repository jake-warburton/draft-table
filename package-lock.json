      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/contracts": {
      "name": "@draft-table/contracts",
      "version": "0.0.0"
    },
    "packages/engine": {
      "name": "@draft-table/engine",
      "version": "0.0.0"
    },
    "packages/set-omens": {
      "name": "@draft-table/set-omens",
      "version": "0.0.0"
