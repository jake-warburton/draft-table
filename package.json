{
  "name": "draft-table",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node --test tests/*.test.mjs && npm run test --workspaces --if-present",
    "size": "npm run build && node scripts/bundle-size.mjs",
    "dev": "npm run build && npm --workspace @draft-table/web run serve"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "5.9.2"
  }
}
