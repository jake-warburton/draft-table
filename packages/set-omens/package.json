{
  "name": "@draft-table/set-omens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema-validation": "./src/schema-validation.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ../../scripts/lint.mjs src",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:evidence": "node test/evidence-command.mjs",
    "test:public-source-evidence": "node test/public-source-evidence-command.mjs",
    "test:recipe-identity-evidence": "node test/recipe-identity-evidence-command.mjs",
    "test:recipe-rarity-evidence": "node test/recipe-rarity-evidence-command.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0"
  }
}
