{
  "name": "@draft-table/set-omens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema-validation": "./src/schema-validation.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ../../scripts/lint.mjs src",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:evidence": "node test/evidence-command.mjs",
    "test:public-source-evidence": "node test/public-source-evidence-command.mjs",
    "test:recipe-identity-evidence": "node test/recipe-identity-evidence-command.mjs",
    "test:recipe-rarity-evidence": "node test/recipe-rarity-evidence-command.mjs",
    "test:draft-eligibility-evidence": "node test/draft-eligibility-evidence-command.mjs",
    "test:recipe-pool-identity-evidence": "node test/recipe-pool-identity-evidence-command.mjs",
    "test:recipe-layout-pool-resolution-evidence": "node test/recipe-layout-pool-resolution-evidence-command.mjs",
    "test:collation-weight-tables-evidence": "node test/collation-weight-tables-evidence-command.mjs",
    "test:collation-weighted-selection-evidence": "node test/collation-weight-ticket-selection-evidence-command.mjs",
    "test:collation-sample-selection-evidence": "node test/collation-sample-selection-evidence-command.mjs",
    "test:pack-local-pool-draw-state-evidence": "node test/pack-local-pool-draw-state-evidence-command.mjs",
    "test:pack-local-pool-ticket-selection-evidence": "node test/pack-local-pool-ticket-selection-evidence-command.mjs",
    "test:pack-local-pool-sample-selection-evidence": "node test/pack-local-pool-sample-selection-evidence-command.mjs"
  },
  "dependencies": {
    "@draft-table/engine": "0.0.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0"
  }
}
